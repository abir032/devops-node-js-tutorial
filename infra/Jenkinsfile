pipeline {
    agent any

    options {
        disableConcurrentBuilds()          // Terraform state must not be changed twice at once
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'],
               description: 'plan = only show changes. apply/destroy = ask for approval, then run')
        string(name: 'MY_IP', defaultValue: '',
               description: 'Your public IP with /32, e.g. 103.12.34.56/32 (must match what you used before)')
    }

    environment {
        TF_IN_AUTOMATION    = 'true'            // less "next step" text in the output
        TF_INPUT            = '0'               // never wait for typed input
        TF_VAR_my_ip        = "${params.MY_IP}" // fills variable "my_ip"
        AWS_DEFAULT_REGION  = 'us-east-1'
        TF_PLUGIN_CACHE_DIR = '/tmp/tfcache'    // inside the container (mounted from the server)
    }

    stages {

        stage('Plan') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.13'
                    args  '--entrypoint= -e HOME=/tmp -v /var/lib/jenkins/tf-plugin-cache:/tmp/tfcache'
                    reuseNode true
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir('infra') {
                        sh '''
                            test -n "$TF_VAR_my_ip" || { echo "MY_IP is empty. Build with parameters."; exit 1; }
                            terraform version
                            terraform fmt -check -diff || echo "WARNING: some files are not formatted"
                            terraform init
                            terraform validate
                            if [ "$ACTION" = "destroy" ]; then
                                terraform plan -destroy -out=tfplan
                            else
                                terraform plan -out=tfplan
                            fi
                        '''
                    }
                }
            }
        }

        stage('Approve') {
            when { expression { params.ACTION in ['apply', 'destroy'] } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Read the plan in the log above. Run '${params.ACTION}' now?",
                          ok: params.ACTION.toUpperCase()
                }
            }
        }

        stage('Apply') {
            when { expression { params.ACTION in ['apply', 'destroy'] } }
            agent {
                docker {
                    image 'hashicorp/terraform:1.13'
                    args  '--entrypoint= -e HOME=/tmp -v /var/lib/jenkins/tf-plugin-cache:/tmp/tfcache'
                    reuseNode true
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir('infra') {
                        sh 'terraform apply tfplan'
                        sh 'terraform output || true'
                    }
                }
            }
        }
    }

    post {
        always  { sh 'rm -f infra/tfplan' }     // a plan file can contain secrets, remove it
        aborted { echo 'Not approved or aborted. Nothing was changed.' }
        failure { echo 'Failed. If it failed in Apply, check the state with a new plan.' }
    }
}
